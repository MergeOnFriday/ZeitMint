{
  "$schema": "https://zeitmint.com/partner-capability.schema.json",
  "name": "ZeitMint",
  "url": "https://zeitmint.com",
  "contact": "devs@zeitmint.com",
  "apiVersion": "1.0",
  "sdk": {
    "package": "@zeitmint/launch-kit",
    "version": "0.3.0",
    "status": "partner-testing",
    "repository": "https://github.com/MergeOnFriday/zeitmint/tree/main/packages/launch-kit"
  },
  "partnerApi": "https://zeitmint.com/partner-api.json",
  "capabilities": "https://zeitmint.com/api/v1/partner/capabilities",
  "partnerAuthentication": "bearer",
  "integrations": [
    {
      "id": "uniswap-v4",
      "packageExport": "@zeitmint/launch-kit/integrations/uniswap-v4",
      "mode": "intent-only",
      "executesOnchain": false
    }
  ],
  "boundaries": {
    "deploysTokens": false,
    "signsTransactions": false,
    "movesFunds": false,
    "configuresLiquidity": false,
    "requiresPartnerApproval": true
  }
}
