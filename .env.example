# Optional public address for the Robinhood Chain testnet provenance experiment.
# Leave blank to keep the registry action disabled.
NEXT_PUBLIC_RH_REGISTRY_ADDRESS=

# Server-only Telegram credentials used for the founding list and visitor alerts.
# Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON object of partner IDs to bearer tokens. Keep this server-only.
# Example: {"your-launchpad":"generate-a-long-random-secret"}
ZEITMINT_PARTNER_KEYS=
