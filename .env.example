# Public browser configuration. These values are not secrets, but each
# deployment should intentionally provide its own recipient and registry.
NEXT_PUBLIC_PAYMENT_NETWORK=solana
NEXT_PUBLIC_PAYMENT_ASSET=USDC
NEXT_PUBLIC_PAYMENT_AMOUNT=49
NEXT_PUBLIC_PAYMENT_RECIPIENT=
NEXT_PUBLIC_RH_REGISTRY_ADDRESS=

# Server-only Telegram credentials. Never prefix these with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# JSON object of partner IDs to bearer tokens. Keep this server-only.
# Example: {"your-launchpad":"generate-a-long-random-secret"}
ZEITMINT_PARTNER_KEYS=
