{
  "name": "zeitmint",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "npm run sdk:build",
    "dev": "next dev",
    "build": "npm run sdk:build && next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "sdk:build": "npm run build --workspace @zeitmint/launch-kit",
    "sdk:test": "npm run test --workspace @zeitmint/launch-kit",
    "sdk:pack": "mkdir -p artifacts && npm pack --workspace @zeitmint/launch-kit --pack-destination ./artifacts",
    "app:test": "node --experimental-strip-types --test test/*.test.mjs",
    "schema:check": "node scripts/check-schemas.mjs",
    "check": "npm run schema:check && npm run sdk:test && npm run app:test && npm run lint && npm run build",
    "partner:key": "node scripts/generate-partner-key.mjs",
    "telegram:chat-id": "node scripts/get-telegram-chat-id.mjs",
    "env:vercel": "node scripts/sync-vercel-env.mjs",
    "deploy": "npm run env:vercel && vercel --prod"
  },
  "dependencies": {
    "@zeitmint/launch-kit": "0.3.0",
    "next": "16.2.12",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "esbuild": "0.28.1",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "type": "module"
}
